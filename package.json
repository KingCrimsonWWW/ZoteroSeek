{
  "name": "zotero-seek-workspace",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "description": "ZoteroSeek: DSH 插件，把本地 Zotero 文献库 + MinerU Markdown 接进 DeepSeek Harness",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
